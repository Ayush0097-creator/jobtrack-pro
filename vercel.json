{
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://jobtrack-pro-api-1264.onrender.com/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://jobtrack-pro-api-1264.onrender.com/media/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
